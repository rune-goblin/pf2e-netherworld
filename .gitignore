node_modules/
dist/
.vite-cache/
.DS_Store
*.zip
*.log

# Compiled LevelDB packs are built from packs/_source by `npm run build:packs`
# (gitignored like dist/); only the diffable JSON sources are tracked. The binary
# DB churns its filenames on every compaction, so it stays out of git. The `packs/*`
# form also covers the build helper's transient packs/.pack-staging/ and any new pack.
packs/*
!packs/_source/

# Local dev paths + reference symlinks (sandbox only, created by npm run setup)
.dev-paths.json
_pf2e-source
_foundry-data
_foundry-modules
