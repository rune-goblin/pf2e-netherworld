      "name": "Shattered Echo",
      "type": "action",
      "img": "systems/pf2e/icons/actions/Passive.webp",
      "system": {
        "description": {
          "gm": "",
          "value": "<p>If the original does something the reflection genuinely cannot follow — breaking line of sight to the reflection, or shattering the pane it emerged from — the reflection has nothing to echo and is <strong>off-guard until the end of its next turn</strong>.</p>"
        },
